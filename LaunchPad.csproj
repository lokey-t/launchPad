<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>LaunchPad</AssemblyName>
    <RootNamespace>LaunchPad</RootNamespace>
    <Version>0.95</Version>
    <AssemblyVersion>0.95.0.0</AssemblyVersion>
    <FileVersion>0.95.0.0</FileVersion>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- WPF 通过 app.manifest 声明 PerMonitorV2 DPI，抑制 WinForms 分析器的重复建议 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 避免 WPF + WinForms 的全局 using 命名冲突（WinForms/System.Drawing 类型在代码中显式引用） -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
