<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <AssemblyName>LaunchPad.Setup</AssemblyName><RootNamespace>LaunchPad.Setup</RootNamespace><Version>0.98</Version>
    <ApplicationIcon>../Assets/app.ico</ApplicationIcon><ApplicationManifest>../app.manifest</ApplicationManifest><SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Worker/**/*.cs" />
    <Resource Include="../Assets/app-icon-glass-v2.png" Link="icon.png" />
    <EmbeddedResource Include="$(PayloadDirectory)/payload.zip" LogicalName="payload.zip" Condition="Exists('$(PayloadDirectory)/payload.zip')" />
    <EmbeddedResource Include="$(PayloadDirectory)/payload.json" LogicalName="payload.json" Condition="Exists('$(PayloadDirectory)/payload.json')" />
  </ItemGroup>
  <Target Name="RequirePayloadForPublish" BeforeTargets="Publish"><Error Condition="!Exists('$(PayloadDirectory)/payload.zip') Or !Exists('$(PayloadDirectory)/payload.json')" Text="Use tools/Build-Installer.ps1 to publish with the verified payload." /></Target>
</Project>
