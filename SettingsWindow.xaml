<Window x:Class="LaunchPad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:LaunchPad.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LaunchPad.Converters"
        Title="LaunchPad 设置" Width="860" Height="680" FontFamily="Microsoft YaHei UI"
        Icon="/Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <conv:SliderFillConverter x:Key="SliderFillConv" />
        <!-- 开关 -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                Background="{DynamicResource ToggleOffBrush}">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 拖动悬停滑块：参照截图样式 —— 灰色轨道 + 蓝色填充（连续延伸至滑块中心）+ 白色圆形滑块 -->
        <Style x:Key="HoverSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- 灰色轨道 -->
                            <Border x:Name="TrackLine" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource ToggleOffBrush}" />
                            <!-- 蓝色填充：宽度随 Value 连续变化，恰好延伸到滑块中心 -->
                            <Rectangle x:Name="FillLine" Height="6" RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource SliderFillBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource SliderFillConv}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding ElementName="TrackLine" Path="ActualWidth" />
                                        <Binding ElementName="SliderThumb" Path="ActualWidth" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                                         Stroke="#C9CDD4" StrokeThickness="1.2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.22" Color="#000000" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Width" Value="18" />
                                                        <Setter TargetName="Knob" Property="Height" Value="18" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Knob" Property="Width" Value="18" />
                                                        <Setter TargetName="Knob" Property="Height" Value="18" />
                                                        <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource SliderFillBrush}" />
                                                        <Setter TargetName="Knob" Property="StrokeThickness" Value="2.2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航项 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 外观选项卡片 -->
        <Style x:Key="OptionCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Width="92" Height="40" CornerRadius="10"
                                Background="{DynamicResource SubPanelBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置分组标题 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 设置行：名称 + 控件 -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SubPanelBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>
    <Border x:Name="SettingsCard" Background="{DynamicResource PanelBgBrush}" CornerRadius="22" Margin="18"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MouseLeftButtonDown="Content_MouseDown">
        <Grid x:Name="SettingsSurfaceContent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="192" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SubPanelBgBrush}" CornerRadius="0">
                <Grid Margin="18,28,18,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="10,0,0,30">
                        <TextBlock Text="LaunchPad" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc '偏好设置'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="{loc:Loc '通用'}" GroupName="nav" IsChecked="True" Tag="general" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavHotkey" Style="{StaticResource NavItem}" Content="{loc:Loc '快捷键'}" GroupName="nav" Tag="hotkey" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Content="{loc:Loc '外观与动效'}" GroupName="nav" Tag="appearance" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavManage" Style="{StaticResource NavItem}" Content="{loc:Loc '分类管理'}" GroupName="nav" Tag="manage" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavBackup" Style="{StaticResource NavItem}" Content="{loc:Loc '备份与恢复'}" GroupName="nav" Tag="backup" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavPlugins" Style="{StaticResource NavItem}" Content="{loc:Loc '插件'}" GroupName="nav" Tag="plugins" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="{loc:Loc '关于'}" GroupName="nav" Tag="about" Checked="Nav_Checked" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{loc:Loc '让常用工具触手可及'}" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource TextHintBrush}" />
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="30,26,30,22">
                <Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="*" /><RowDefinition Height="62" /></Grid.RowDefinitions>
                <Grid MouseLeftButtonDown="Header_MouseDown">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="{loc:Loc '通用'}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="PageDescription" Text="{loc:Loc '设置启动方式，以及启动台的日常行为。'}" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Content="✕" Width="34" Height="34" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{loc:Loc '保存并关闭'}" Click="CloseSettings_Click" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="SettingsPages">
                <!-- 常规 -->
                <StackPanel x:Name="PanelGeneral">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '语言'}" />
                    <ComboBox x:Name="LanguageChoice" MinHeight="34" Margin="0,0,0,18" SelectionChanged="Language_Changed">
                        <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '启动'}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '开机自启'}" />
                        <ToggleButton x:Name="AutoStartToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                    </Grid>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '启动时最小化到托盘'}" />
                        <ToggleButton x:Name="MinimizeTrayToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="Tray_Changed" Unchecked="Tray_Changed" />
                    </Grid>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '行为'}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '解析应用快捷方式'}" />
                        <ToggleButton x:Name="ResolveShortcutsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="ResolveShortcuts_Changed" Unchecked="ResolveShortcuts_Changed" />
                    </Grid>
                    <TextBlock Text="{loc:Loc '添加快捷方式时链接到原文件，保留启动参数。无法解析时保留快捷方式；仅影响之后添加的条目。'}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '单击启动应用（关闭则为双击启动）'}" />
                        <ToggleButton x:Name="SingleClickToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="LaunchMode_Changed" Unchecked="LaunchMode_Changed" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '弹窗位置'}" Margin="0,0,20,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="PosCenter" Style="{StaticResource OptionCard}" Content="{loc:Loc '屏幕居中'}"
                                         GroupName="pos" Tag="Center" Checked="Pos_Changed" />
                            <RadioButton x:Name="PosCursor" Style="{StaticResource OptionCard}" Content="{loc:Loc '跟随鼠标'}"
                                         GroupName="pos" Tag="Cursor" Checked="Pos_Changed" />
                            <RadioButton x:Name="PosLast" Style="{StaticResource OptionCard}" Content="{loc:Loc '上次位置'}"
                                         GroupName="pos" Tag="Last" Checked="Pos_Changed" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '关闭方式'}" Margin="0,6,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '启动应用后自动关闭启动器'}" />
                        <ToggleButton x:Name="HideAfterLaunchToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="HideAfterLaunch_Changed" Unchecked="HideAfterLaunch_Changed" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '焦点离开启动器时自动关闭'}" />
                        <ToggleButton x:Name="HideOnFocusLostToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="HideOnFocusLost_Changed" Unchecked="HideOnFocusLost_Changed" />
                    </Grid>
                    <TextBlock x:Name="GeneralHotkeyHint" Text="" FontSize="11"
                               Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap" />
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,16" />
                    <TextBlock Text="{loc:Loc '拖拽悬停'}" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="{loc:Loc '文件夹自动展开'}" Style="{StaticResource RowLabel}" Margin="0,6,0,8" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                        <Slider x:Name="FolderHoverDelay" Style="{StaticResource HoverSlider}" Minimum="0.3" Maximum="5" ValueChanged="HoverDelay_Changed" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=FolderHoverDelay, StringFormat={}{0:0.00} 秒}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{loc:Loc '分类自动切换'}" Style="{StaticResource RowLabel}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                        <Slider x:Name="CategoryHoverDelay" Style="{StaticResource HoverSlider}" Minimum="0.3" Maximum="5" ValueChanged="HoverDelay_Changed" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=CategoryHoverDelay, StringFormat={}{0:0.00} 秒}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>                </StackPanel>

                <!-- 快捷键 -->
                <StackPanel x:Name="PanelHotkey" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '呼出快捷键'}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '全局快捷键'}" Margin="0,0,16,0" />
                        <Border Grid.Column="1" Background="{DynamicResource SearchBgBrush}" CornerRadius="10"
                                Width="200" Height="34">
                            <TextBox x:Name="HotkeyInput" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyInput_PreviewKeyDown"
                                     LostFocus="HotkeyInput_LostFocus" />
                        </Border>
                        <Button Grid.Column="2" x:Name="ModifyHotkeyBtn" Content="{loc:Loc '修改'}" Width="64" Height="32"
                                Margin="10,0,0,0" Cursor="Hand" Click="ModifyHotkey_Click" />
                    </Grid>
                    <TextBlock x:Name="HotkeyStatus" FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                               Margin="0,2,0,0" Text="{loc:Loc '点击“修改”后按下新的组合键（如 Ctrl + Alt + Q）'}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '分类快捷键'}" Margin="0,22,0,10" />
                    <ListBox x:Name="HotkeyCategoryList" Height="150" SelectionChanged="HotkeyCategoryList_SelectionChanged" Background="{DynamicResource SubPanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="8,7">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding HotkeyDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="18,0,0,0" />
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddCatHotkeyBtn" Content="{loc:Loc '添加快捷键'}" Width="108" Height="34"
                                Cursor="Hand" Click="AddCatHotkey_Click" IsEnabled="False" />
                        <Button x:Name="ClearCatHotkeyBtn" Content="{loc:Loc '删除快捷键'}" Width="108" Height="34" Margin="8,0,0,0" Cursor="Hand" Click="ClearCatHotkey_Click" IsEnabled="False" />
                    </StackPanel>
                    <Border Margin="0,14,0,0" Padding="12,10" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SubPanelBgBrush}" CornerRadius="8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc '允许分类快捷键关闭窗口'}" FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc '开启后，若启动台已打开且当前就是该分类，按下快捷键可关闭窗口。'}" FontSize="11"
                                           Foreground="{DynamicResource TextHintBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton x:Name="AllowCatHotkeyCloseToggle" Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="AllowCatHotkeyClose_Changed" Unchecked="AllowCatHotkeyClose_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 外观 -->
                <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                    <Button Content="{loc:Loc '打开主题中心 · 配色与背景'}" Click="OpenThemeCenter" Padding="12,10" Margin="0,0,0,14" HorizontalAlignment="Left" />
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="{loc:Loc '主页显示主题按钮'}" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="ShowThemeButtonToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Checked="ShowThemeButton_Changed" Unchecked="ShowThemeButton_Changed" />
                    </Grid>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '外观'}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '主题模式'}" Margin="0,0,20,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="ThemeLight" Style="{StaticResource OptionCard}" Content="{loc:Loc '浅色'}"
                                         GroupName="theme" Tag="Light" Checked="Theme_Changed" />
                            <RadioButton x:Name="ThemeDark" Style="{StaticResource OptionCard}" Content="{loc:Loc '深色'}"
                                         GroupName="theme" Tag="Dark" Checked="Theme_Changed" />
                            <RadioButton x:Name="ThemeSystem" Style="{StaticResource OptionCard}" Content="{loc:Loc '跟随系统'}"
                                         GroupName="theme" Tag="System" Checked="Theme_Changed" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '图标大小'}" Margin="0,0,20,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="SizeSmall" Style="{StaticResource OptionCard}" Content="{loc:Loc '小'}"
                                         GroupName="size" Tag="Small" Checked="Size_Changed" />
                            <RadioButton x:Name="SizeMedium" Style="{StaticResource OptionCard}" Content="{loc:Loc '中'}"
                                         GroupName="size" Tag="Medium" Checked="Size_Changed" />
                            <RadioButton x:Name="SizeLarge" Style="{StaticResource OptionCard}" Content="{loc:Loc '大'}"
                                         GroupName="size" Tag="Large" Checked="Size_Changed" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,20" />
                    <TextBlock Text="{loc:Loc '动画过渡'}" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="{loc:Loc '应用于窗口、分类、文件夹与拖动让位。'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AnimationOff" Content="{loc:Loc '关闭'}" Tag="Off" GroupName="animation" Style="{StaticResource OptionCard}" Checked="Animation_Changed" />
                        <RadioButton x:Name="AnimationFast" Content="{loc:Loc '快速'}" Tag="Fast" GroupName="animation" Style="{StaticResource OptionCard}" Checked="Animation_Changed" />
                        <RadioButton x:Name="AnimationBalanced" Content="{loc:Loc '均衡'}" Tag="Balanced" GroupName="animation" Style="{StaticResource OptionCard}" Checked="Animation_Changed" />
                        <RadioButton x:Name="AnimationOptimized" Content="{loc:Loc '优化'}" Tag="Optimized" GroupName="animation" Style="{StaticResource OptionCard}" Checked="Animation_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="AnimationDescription" Text="{loc:Loc '兼顾响应速度与视觉连续性。'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />                </StackPanel>

                <!-- 分类管理 -->
                <StackPanel x:Name="PanelManage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '分类管理'}" />
                    <TextBlock Text="{loc:Loc '按住分类行上下拖动排序，顺序会同步到主页。删除分类不会删除磁盘文件。'}" FontSize="11"
                               Foreground="{DynamicResource TextHintBrush}" Margin="0,0,0,10" />
                    <ListBox x:Name="CategoryList" Height="220" BorderThickness="1"
                             BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SubPanelBgBrush}"
                             SelectionChanged="CategoryList_SelectionChanged" VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False"
                             PreviewMouseLeftButtonDown="CategorySort_Down" PreviewMouseMove="CategorySort_Move" PreviewMouseLeftButtonUp="CategorySort_Up">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⠿" Margin="0,0,12,0" Foreground="{DynamicResource TextHintBrush}" />
                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Entries.Count, StringFormat=（{0} 个条目）}" FontSize="12"
                                               Foreground="{DynamicResource TextHintBrush}" Margin="8,0,0,0" />

                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="RenameCatBtn" Content="{loc:Loc '重命名'}" Width="72" Height="34" Margin="0,0,8,0"
                                Cursor="Hand" Click="RenameCat_Click" IsEnabled="False" />
                        <Button x:Name="DeleteCatBtn" Content="{loc:Loc '删除分类'}" Width="86" Height="34" Margin="0,0,8,0"
                                Cursor="Hand" Click="DeleteCat_Click" IsEnabled="False" />
                        <Button Content="{loc:Loc '清空全部条目'}" Width="96" Height="34" Margin="0,0,8,0"
                                Cursor="Hand" Click="ClearAll_Click" />

                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PanelBackup" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '恢复出厂设置'}" />
                    <TextBlock Text="{loc:Loc '清空分类与条目，重置所有设置；已保存和自动备份点都会保留。不会删除磁盘中的原文件。'}" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="{loc:Loc '恢复出厂设置…'}" Click="FactoryReset_Click" HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,20" />
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '自动备份'}" />
                    <Grid Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc '修改后自动创建备份点'}" />
                        <ToggleButton x:Name="AutoBackupToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}" Checked="AutoBackup_Changed" Unchecked="AutoBackup_Changed" />
                    </Grid>
                    <TextBlock Text="{loc:Loc '设置、条目位置或图标背景变化后备份。自动记录最多保留 30 条；点击保存后长期保留。'}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
                    <WrapPanel Margin="0,0,0,20">
                        <Button Content="{loc:Loc '立即备份'}" Click="CreateBackup_Click" Padding="14,8" Margin="0,0,8,6" />
                        <Button Content="{loc:Loc '导入备份'}" Click="ImportBackup_Click" Padding="14,8" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '备份点'}" />
                    <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                    <ListBox x:Name="BackupList" Height="115" Background="{DynamicResource SubPanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SelectionChanged="BackupList_SelectionChanged">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,7">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" />
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel x:Name="BackupActions" IsEnabled="False" Margin="0,12,0,0">
                        <Button Content="{loc:Loc '恢复'}" Click="RestoreBackup_Click" Padding="12,7" Margin="0,0,7,7" />
                        <Button x:Name="SaveBackupButton" Content="{loc:Loc '保存'}" Click="SaveBackup_Click" Padding="12,7" Margin="0,0,7,7" />
                        <Button Content="{loc:Loc '重命名'}" Click="RenameBackup_Click" Padding="12,7" Margin="0,0,7,7" />
                        <Button Content="{loc:Loc '导出'}" Click="ExportBackup_Click" Padding="12,7" Margin="0,0,7,7" />
                        <Button Content="{loc:Loc '删除'}" Click="DeleteBackup_Click" Padding="12,7" Margin="0,0,7,7" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Loc '配置、自定义图标与背景打包为 .qdtbackup。导入后可选择恢复。'}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextHintBrush}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel x:Name="PanelPlugins" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '插件'}" />
                    <TextBlock Text="{loc:Loc '插件按需运行。安装后需手动启用，请仅使用可信来源的插件。'}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
                    <Button x:Name="InstallPluginButton" Content="{loc:Loc '安装插件…'}" Click="InstallPlugin_Click" HorizontalAlignment="Left" Padding="16,8" Margin="0,0,0,18" />
                    <StackPanel x:Name="PluginCards" />
                </StackPanel>
                <!-- 关于 -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc '关于'}" />
                    <TextBlock Text="LaunchPad" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,4" />
                    <TextBlock x:Name="AboutVersionText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="· 全局快捷键呼出（默认 Ctrl + Space）&#10;· 拖入文件 / 快捷方式即可添加&#10;· 拖动图标排序，拖到另一个图标上可合并为文件夹&#10;· 开机自启、浅色 / 深色主题"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" />
                    <Border Background="{DynamicResource SubPanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,20,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc '软件更新'}" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
                            <Button x:Name="CheckUpdatesButton" Grid.Column="1" Click="CheckUpdates_Click" Padding="16,9" MinWidth="112">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="{loc:Loc '检查更新'}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Content" Value="{loc:Loc '正在检查…'}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{loc:Loc '自动检测 GitHub / Gitee 的正式版本，更新保留应用数据。'}"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />
                        </Grid>
                    </Border>
                    <Button x:Name="ReopenOnboardingButton" Content="{loc:Loc '重新进入用户引导'}" Click="ReopenOnboarding_Click"
                            HorizontalAlignment="Left" Padding="16,9" Margin="0,20,0,0" />
                    <TextBlock Text="{loc:Loc '从当前设置开始重新引导，完成后应用修改。'}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                    <TextBlock x:Name="AboutPathText" FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                               Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="{loc:Loc '设置会自动保存'}" FontSize="11" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center" />
                    <Button Content="{loc:Loc '完成'}" Width="96" Height="40" Background="{DynamicResource AccentDeepBrush}" Foreground="White" BorderThickness="0"
                            HorizontalAlignment="Right" Click="Done_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
