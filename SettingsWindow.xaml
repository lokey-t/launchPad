<Window x:Class="LaunchPad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LaunchPad.Converters"
        Title="LaunchPad 设置" Width="860" Height="680" FontFamily="Microsoft YaHei UI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <conv:SliderFillConverter x:Key="SliderFillConv" />
        <!-- 开关 -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                Background="{DynamicResource ToggleOffBrush}">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 拖动悬停滑块：参照截图样式 —— 灰色轨道 + 蓝色填充（连续延伸至滑块中心）+ 白色圆形滑块 -->
        <Style x:Key="HoverSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- 灰色轨道 -->
                            <Border x:Name="TrackLine" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource ToggleOffBrush}" />
                            <!-- 蓝色填充：宽度随 Value 连续变化，恰好延伸到滑块中心 -->
                            <Rectangle x:Name="FillLine" Height="6" RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource SliderFillBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource SliderFillConv}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding ElementName="TrackLine" Path="ActualWidth" />
                                        <Binding ElementName="SliderThumb" Path="ActualWidth" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                                         Stroke="#C9CDD4" StrokeThickness="1.2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.22" Color="#000000" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Width" Value="18" />
                                                        <Setter TargetName="Knob" Property="Height" Value="18" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Knob" Property="Width" Value="18" />
                                                        <Setter TargetName="Knob" Property="Height" Value="18" />
                                                        <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource SliderFillBrush}" />
                                                        <Setter TargetName="Knob" Property="StrokeThickness" Value="2.2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航项 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 外观选项卡片 -->
        <Style x:Key="OptionCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Width="92" Height="40" CornerRadius="10"
                                Background="{DynamicResource SubPanelBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置分组标题 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 设置行：名称 + 控件 -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SubPanelBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>
    <Border x:Name="SettingsCard" Background="{DynamicResource PanelBgBrush}" CornerRadius="22" Margin="18"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MouseLeftButtonDown="Content_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="192" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SubPanelBgBrush}" CornerRadius="22,0,0,22">
                <Grid Margin="18,28,18,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="10,0,0,30">
                        <TextBlock Text="LaunchPad" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="偏好设置" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="常规与启动" GroupName="nav" IsChecked="True" Tag="general" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavHotkey" Style="{StaticResource NavItem}" Content="快捷键" GroupName="nav" Tag="hotkey" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Content="外观与动效" GroupName="nav" Tag="appearance" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavManage" Style="{StaticResource NavItem}" Content="应用管理" GroupName="nav" Tag="manage" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="关于" GroupName="nav" Tag="about" Checked="Nav_Checked" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="让常用工具触手可及" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource TextHintBrush}" />
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="30,26,30,22">
                <Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="*" /><RowDefinition Height="62" /></Grid.RowDefinitions>
                <Grid MouseLeftButtonDown="Header_MouseDown">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="常规与启动" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="PageDescription" Text="设置启动方式，以及启动台的日常行为。" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Content="✕" Width="34" Height="34" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="保存并关闭" Click="CloseSettings_Click" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="SettingsPages">
                <!-- 常规 -->
                <StackPanel x:Name="PanelGeneral">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="启动" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="开机自启" />
                        <ToggleButton x:Name="AutoStartToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                    </Grid>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="启动时最小化到托盘" />
                        <ToggleButton x:Name="MinimizeTrayToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="Tray_Changed" Unchecked="Tray_Changed" />
                    </Grid>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="行为" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="单击启动应用（关闭则为双击启动）" />
                        <ToggleButton x:Name="SingleClickToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="LaunchMode_Changed" Unchecked="LaunchMode_Changed" />
                    </Grid>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="关闭方式" Margin="0,6,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="启动应用后自动关闭启动器" />
                        <ToggleButton x:Name="HideAfterLaunchToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="HideAfterLaunch_Changed" Unchecked="HideAfterLaunch_Changed" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="焦点离开启动器时自动关闭" />
                        <ToggleButton x:Name="HideOnFocusLostToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Checked="HideOnFocusLost_Changed" Unchecked="HideOnFocusLost_Changed" />
                    </Grid>
                    <TextBlock x:Name="GeneralHotkeyHint" Text="" FontSize="11"
                               Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap" />
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,16" />
                    <TextBlock Text="拖拽悬停" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="文件夹自动展开" Style="{StaticResource RowLabel}" Margin="0,6,0,8" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                        <Slider x:Name="FolderHoverDelay" Style="{StaticResource HoverSlider}" Minimum="0.3" Maximum="5" ValueChanged="HoverDelay_Changed" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=FolderHoverDelay, StringFormat={}{0:0.00} 秒}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="分类自动切换" Style="{StaticResource RowLabel}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                        <Slider x:Name="CategoryHoverDelay" Style="{StaticResource HoverSlider}" Minimum="0.3" Maximum="5" ValueChanged="HoverDelay_Changed" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=CategoryHoverDelay, StringFormat={}{0:0.00} 秒}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>                </StackPanel>

                <!-- 快捷键 -->
                <StackPanel x:Name="PanelHotkey" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="呼出快捷键" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="全局快捷键" Margin="0,0,16,0" />
                        <Border Grid.Column="1" Background="{DynamicResource SearchBgBrush}" CornerRadius="10"
                                Width="200" Height="34">
                            <TextBox x:Name="HotkeyInput" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyInput_PreviewKeyDown"
                                     LostFocus="HotkeyInput_LostFocus" />
                        </Border>
                        <Button Grid.Column="2" x:Name="ModifyHotkeyBtn" Content="修改" Width="64" Height="32"
                                Margin="10,0,0,0" Cursor="Hand" Click="ModifyHotkey_Click" />
                    </Grid>
                    <TextBlock x:Name="HotkeyStatus" FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                               Margin="0,2,0,0" Text="点击“修改”后按下新的组合键（如 Ctrl + Alt + Q）" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 外观 -->
                <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="外观" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="主题模式" Margin="0,0,20,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="ThemeLight" Style="{StaticResource OptionCard}" Content="浅色"
                                         GroupName="theme" Tag="Light" Checked="Theme_Changed" />
                            <RadioButton x:Name="ThemeDark" Style="{StaticResource OptionCard}" Content="深色"
                                         GroupName="theme" Tag="Dark" Checked="Theme_Changed" />
                            <RadioButton x:Name="ThemeSystem" Style="{StaticResource OptionCard}" Content="跟随系统"
                                         GroupName="theme" Tag="System" Checked="Theme_Changed" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="图标大小" Margin="0,0,20,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="SizeSmall" Style="{StaticResource OptionCard}" Content="小"
                                         GroupName="size" Tag="Small" Checked="Size_Changed" />
                            <RadioButton x:Name="SizeMedium" Style="{StaticResource OptionCard}" Content="中"
                                         GroupName="size" Tag="Medium" Checked="Size_Changed" />
                            <RadioButton x:Name="SizeLarge" Style="{StaticResource OptionCard}" Content="大"
                                         GroupName="size" Tag="Large" Checked="Size_Changed" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="弹窗位置" Margin="0,0,20,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="PosCenter" Style="{StaticResource OptionCard}" Content="屏幕居中"
                                         GroupName="pos" Tag="Center" Checked="Pos_Changed" />
                            <RadioButton x:Name="PosCursor" Style="{StaticResource OptionCard}" Content="跟随鼠标"
                                         GroupName="pos" Tag="Cursor" Checked="Pos_Changed" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,20" />
                    <TextBlock Text="动画过渡" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="应用于窗口、分类、文件夹与拖动让位。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AnimationOff" Content="关闭" Tag="Off" GroupName="animation" Style="{StaticResource OptionCard}" Checked="Animation_Changed" />
                        <RadioButton x:Name="AnimationFast" Content="快速" Tag="Fast" GroupName="animation" Style="{StaticResource OptionCard}" Checked="Animation_Changed" />
                        <RadioButton x:Name="AnimationBalanced" Content="均衡" Tag="Balanced" GroupName="animation" Style="{StaticResource OptionCard}" Checked="Animation_Changed" />
                        <RadioButton x:Name="AnimationOptimized" Content="优化" Tag="Optimized" GroupName="animation" Style="{StaticResource OptionCard}" Checked="Animation_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="AnimationDescription" Text="兼顾响应速度与视觉连续性。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />                </StackPanel>

                <!-- 应用管理 -->
                <StackPanel x:Name="PanelManage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="应用管理" />
                    <TextBlock Text="管理分类与条目。删除分类不会删除磁盘文件。" FontSize="11"
                               Foreground="{DynamicResource TextHintBrush}" Margin="0,0,0,10" />
                    <ListBox x:Name="CategoryList" Height="220" BorderThickness="1"
                             BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SubPanelBgBrush}"
                             SelectionChanged="CategoryList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Entries.Count, StringFormat=（{0} 个条目）}" FontSize="12"
                                               Foreground="{DynamicResource TextHintBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="RenameCatBtn" Content="重命名" Width="72" Height="30" Margin="0,0,8,0"
                                Cursor="Hand" Click="RenameCat_Click" IsEnabled="False" />
                        <Button x:Name="DeleteCatBtn" Content="删除分类" Width="86" Height="30" Margin="0,0,8,0"
                                Cursor="Hand" Click="DeleteCat_Click" IsEnabled="False" />
                        <Button Content="清空全部条目" Width="96" Height="30"
                                Cursor="Hand" Click="ClearAll_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- 关于 -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupTitle}" Text="关于" />
                    <TextBlock Text="LaunchPad" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,4" />
                    <TextBlock Text="轻量级 Windows 应用分类启动器 · v0.1.0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="· 全局快捷键呼出（默认 Ctrl + Space）&#10;· 拖入文件 / 快捷方式即可添加&#10;· 拖动图标排序，拖到另一个图标上可合并为文件夹&#10;· 开机自启、浅色 / 深色主题"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" />
                    <TextBlock x:Name="AboutPathText" FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                               Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="点击完成保存设置" FontSize="11" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center" />
                    <Button Content="完成" Width="96" Height="40" Background="{DynamicResource AccentDeepBrush}" Foreground="White" BorderThickness="0"
                            HorizontalAlignment="Right" Click="Done_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
