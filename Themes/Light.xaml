<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题 · 简约扁平 · 设计文档配色 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F7F6F3" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubPanelBgBrush" Color="#FAFAF8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E8E7E3" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EFEEEA" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TextHintBrush" Color="#9CA3AF" />

    <SolidColorBrush x:Key="TabActiveBgBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="TabActiveTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#A3D5E8" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#DCEFF7" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#2E6D99" />
    <SolidColorBrush x:Key="FolderBrush" Color="#A3D5E8" />

    <SolidColorBrush x:Key="HoverBrush" Color="#F1F0ED" />
    <SolidColorBrush x:Key="SearchBgBrush" Color="#F5F4F1" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="#34C759" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="DragHighlightBrush" Color="#2E6D99" />
    <SolidColorBrush x:Key="SliderFillBrush" Color="#2E86D1" />

</ResourceDictionary>
